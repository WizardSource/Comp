# Q4_0 decode-GEMV through KOMP (KURN's math on a minimal Triton fork)
kernel     q4_0_gemv_triton
op         gemv
weights    q4_0
target     triton
arch       sm_80
mode       dp4a      # packed-word dot products; the interpreter runs the pure-Triton fallback
block_n    64
nb         4
num_warps  4
n          37        # verify shape: a row tail, K steps not a multiple of nb, 3 activation columns
k          416
m          3
tune       mode=dp4a,bytes block_n=32,64 nb=4,8
